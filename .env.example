# Postgres (Neon). Usar connection string de pooling en desarrollo/demo.
# Nunca commits valores reales: esos van en .env (local) o en secretos de Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"


# Passwords del seed demo (Sprint 2). Solo placeholders aquí; valores reales en .env local.
SEED_ADMIN_PASSWORD="change-me-admin"
SEED_OPERATOR_PASSWORD="change-me-operator"


# Auth.js (Sprint 2). Valor real solo en .env local / secretos de Vercel.
# Secret necesario para que Auth.js pueda firmar cookies y sesiones en nuestro sistema.
AUTH_SECRET="generate-a-long-random-string"